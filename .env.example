# Copy to .env and replace every placeholder before starting the services.
APP_ENV=production
APP_NAME=Bika Music API
LOG_LEVEL=INFO

# Public HTTPS base URL of the API (no trailing slash).
PUBLIC_API_BASE_URL=https://api.example.com

# PostgreSQL credentials. URL-encode special characters in the password used in DATABASE_URL.
POSTGRES_USER=bika
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=bika_music_api
DATABASE_URL=postgresql+asyncpg://bika:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@db:5432/bika_music_api

# Redis is required in production for shared rate limiting.
REDIS_URL=redis://redis:6379/0

# Generate independently with: openssl rand -hex 32
API_KEY_PEPPER=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
PLAYBACK_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_64_RANDOM_HEX_CHARACTERS

# Telegram bot token from BotFather. Keep it private.
API_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to create/manage API keys.
# Empty means key management is disabled for all users (secure default).
API_BOT_ALLOWED_USER_IDS=

# The media directory is mounted read-only in the API container.
MEDIA_ROOT=/data/media
RATE_LIMIT_PER_MINUTE=60
PLAYBACK_URL_TTL_SECONDS=300
